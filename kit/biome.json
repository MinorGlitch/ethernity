{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "app/**/*.js",
      "app/**/*.jsx",
      "lib/**/*.js",
      "lib/**/*.mjs",
      "scripts/**/*.mjs",
      "tests/**/*.mjs",
      "build_kit.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
